# ElevenLabs API key (https://elevenlabs.io/app/settings/api-keys) — needed for `bun vk voice`
ELEVENLABS_API_KEY=
# Optional: keep projects outside the repo (absolute path). Default: ./projects
VK_PROJECTS_DIR=
# Optional: custom Chromium executable for rendering
CHROMIUM=
# Optional asset providers
# OpenAI image generation for `bun vk asset gen <p> <name> "<prompt>"`
OPENAI_API_KEY=
# VK_IMAGE_MODEL=gpt-image-1
# Pexels stock photos + videos for `bun vk asset search` (Openverse works without a key)
PEXELS_API_KEY=
# Google Flow through the flowkit agent in tools/flowkit (installed by `bun run setup`, started with `bun run flowkit`)
# FLOW_PROJECT_ID = uuid of a project at https://flow.google.com (copy it from the URL)
FLOW_PROJECT_ID=
# FLOWKIT_URL=http://127.0.0.1:8100
# Reference videos (`bun vk ref add <p> <url>`): yt-dlp is installed to tools/bin by `bun run setup`.
# Extra yt-dlp args, e.g. cookies for posts that need a login: VK_YTDLP_ARGS=--cookies /path/cookies.txt
# VK_YTDLP_ARGS=
# Fallback downloader: a cobalt API instance (self-hosted, or one you have a key for)
# COBALT_API_URL=http://localhost:9000/
# COBALT_API_KEY=
# Speech-to-text model for reference transcripts (default scribe_v2, falls back to scribe_v1)
# VK_STT_MODEL=scribe_v2
# Web studio (Nuevo video / chat): videos built at the same time (one headless Claude each) and the model they use
# VK_STUDIO_MAX_JOBS=3
# VK_CLAUDE_MODEL=claude-opus-5-5
